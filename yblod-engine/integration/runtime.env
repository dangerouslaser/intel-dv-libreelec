# Experimental native adapter installed by the native-dv package.
OCL_ICD_VENDORS=/etc/OpenCL/vendors
NEO_CACHE_PERSISTENT=1
NEO_CACHE_DIR=/storage/.cache/native-dv
NEO_CACHE_MAX_SIZE=67108864
DV_PRIVATE_SOURCE=1
DV_PRIVATE_SOURCE_LIBRARY=/usr/lib/libdv_source_private.so.1
DV_PRIVATE_SOURCE_RESOURCES=/usr/share/native-dv
# Vulkan engine (yblod-engine/vk); Settings > Player > Dolby Vision > Vulkan engine sets DV_ENGINE_VULKAN
DV_ENGINE_VULKAN=1
DV_VULKAN_ENGINE_LIBRARY=/usr/lib/libdv_engine_vk.so.0
# 0: wait for each Vulkan frame before presenting it (the commit waits for its fence otherwise)
DV_VULKAN_ASYNC=1
DV_PRIVATE_VERIFY=0
DV_PRIVATE_VERIFY_RESET=0
DV_PRIVATE_ASYNC=1
DV_PRIVATE_ASYNC_PACK=1
DV_PRIVATE_ASYNC_OVERLAY=0
DV_PRIVATE_SITED=1
DV_PRIVATE_RESIZE=1
DV_PRIVATE_SCANOUT=1
DV_PRIVATE_DIRECT_NO_GL_FINISH=0
DV_PRIVATE_DRAIN_EOF=1
DV_PRIVATE_STARTUP_COMMIT=1
DV_PRIVATE_STARTUP_FULLSCREEN=1
DV_PRIVATE_STARTUP_LATENCY=1
DV_PRIVATE_STARTUP_RESYNC=1
DV_PRIVATE_OVERLAY=1
DV_PRIVATE_GUI_CACHE=1
DV_PRIVATE_GUI_CACHE_HOME=1
# Disabled after a controls-flicker A/B test; retain per-pixel cache checks.
DV_PRIVATE_GUI_REVISION=0
DV_PRIVATE_GUI_HALF=0
DV_PRIVATE_GUI_COVERAGE=0
DV_OVERLAY_TILES=0
DV_OVERLAY_PREPASS=0
DV_OVERLAY_PIXEL_CACHE=1
DV_OVERLAY_SPARSE=1
DV_OVERLAY_CACHE_VERIFY=0
DV_OVERLAY_PROFILE=0
# Per-frame engine JSON trace on stderr (journald); diagnostic only.
DV_ENGINE_FRAME_TRACE=0
# Kodi first-480-frame startup/async-pack timing lines; diagnostic only.
DV_PRIVATE_FRAME_TIMING=0
DV_OVERLAY_GRAY_LUT=1
DV_OVERLAY_SHARED=1
# The overlay pack checks the GUI pixel cache itself (no separate colour pass).
DV_OVERLAY_INLINE=1
DV_DEFER_VA_RELEASE=1
DV_BASE_PREP_FUSED=1
DV_LUMA_GUIDE_FUSED=1
DV_MMR_HORIZONTAL_FUSED=1
DV_SINGLE_PIECEWISE=1
# Reuse polynomial/MMR tables while the RPU composer config is unchanged.
DV_SINGLE_TABLE_CACHE=1
DV_DUAL_TABLE_CACHE=1
# Reconstruct only the L5 active rows plus a filter margin (letterbox skip).
DV_RECON_ACTIVE_ROWS=1
DV_SINGLE_FULL_HEIGHT=1
DV_SINGLE_NV12=1
DV_SINGLE_ORDER2_CHROMA=1
DV_SOURCE_SPACE2=1
DV_DIRECT_P010=1
DV_LUMA_PAIR=1
DV_MMR_DUAL=1
DV_FILTER_FUSED=1
DV_UNPACK_BLOCK=1
DV_MMR_PAIR=0
DV_MMR_UNIFORM=0
DV_MMR_MULHI=0
DV_RECON_2D=1
DV_COLOUR_SCREEN_FUSED=1
DV_MMR_NATIVE_MUL=1
DV_MMR_SIGNED64=0
DV_COLOUR_COMPACT=1
DV_COLOUR_GROUP=256
DV_COLOUR_LOCAL_COMPACT=1
DV_COLOUR_BOUNDED_REFINE=1
DV_COLOUR_SPARSE_REPAIR=1
DV_RESIDENT_INTERMEDIATE=1
DV_MMR_STREAM=1
DV_COLOUR_SUBGROUP=1
DV_MMR_96=1
DV_MMR_64=1
DV_MMR_UNIVARIATE_LUT=1
DV_COLOUR_DIRECT_IMAGES=1
