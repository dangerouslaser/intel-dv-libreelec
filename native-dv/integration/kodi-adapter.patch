diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateScanout.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateScanout.cpp
new file mode 100644
index 00000000..f2881ddb
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateScanout.cpp
@@ -0,0 +1,94 @@
+#include "DVPrivateScanout.h"
+#include <GLES3/gl3.h>
+#include <drm_fourcc.h>
+#include <dlfcn.h>
+#include <unistd.h>
+#include <cstring>
+
+bool CDVPrivateScanout::Initialize(gbm_device* device, void* library)
+{
+  if (!device || !library || m_initialized) return false;
+#define LOAD(member, symbol) member = reinterpret_cast<decltype(member)>(dlsym(library, #symbol)); if (!member) return false
+  LOAD(m_init, dv_scanout_slots_init);
+  LOAD(m_acquire, dv_scanout_slots_acquire);
+  LOAD(m_written, dv_scanout_slots_written);
+  LOAD(m_committed, dv_scanout_slots_committed);
+  LOAD(m_reset, dv_scanout_slots_reset_stream);
+  LOAD(m_restored, dv_scanout_slots_restored);
+  LOAD(m_canDestroy, dv_scanout_slots_can_destroy);
+#undef LOAD
+  m_init(&m_slots);
+  m_initialized = true;
+  m_display = eglGetCurrentDisplay();
+  auto create = reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(eglGetProcAddress("eglCreateImageKHR"));
+  m_destroyImage = reinterpret_cast<PFNEGLDESTROYIMAGEKHRPROC>(eglGetProcAddress("eglDestroyImageKHR"));
+  using Target = void (*)(GLenum, void*);
+  auto target = reinterpret_cast<Target>(eglGetProcAddress("glEGLImageTargetTexture2DOES"));
+  if (!create || !m_destroyImage || !target || m_display == EGL_NO_DISPLAY) return false;
+  GLint previous;
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &previous);
+  bool success = true;
+  for (unsigned slot = 0; slot < 2 && success; ++slot)
+  {
+    m_bo[slot] = gbm_bo_create(device, 3840, 2160, GBM_FORMAT_ARGB8888,
+        GBM_BO_USE_RENDERING | GBM_BO_USE_SCANOUT | GBM_BO_USE_LINEAR);
+    if (!m_bo[slot]) { success = false; break; }
+    int fd = gbm_bo_get_fd(m_bo[slot]);
+    if (fd < 0) { success = false; break; }
+    const EGLint attrs[] = {EGL_WIDTH,3840,EGL_HEIGHT,2160,EGL_LINUX_DRM_FOURCC_EXT,DRM_FORMAT_ARGB8888,
+        EGL_DMA_BUF_PLANE0_FD_EXT,fd,EGL_DMA_BUF_PLANE0_OFFSET_EXT,0,
+        EGL_DMA_BUF_PLANE0_PITCH_EXT,static_cast<EGLint>(gbm_bo_get_stride(m_bo[slot])),EGL_NONE};
+    m_image[slot] = create(m_display,EGL_NO_CONTEXT,EGL_LINUX_DMA_BUF_EXT,nullptr,attrs);
+    close(fd);
+    if (m_image[slot] == EGL_NO_IMAGE_KHR) { success = false; break; }
+    glGenTextures(1,&m_texture[slot]);
+    glBindTexture(GL_TEXTURE_2D,m_texture[slot]);
+    target(GL_TEXTURE_2D,m_image[slot]);
+    glFinish();
+    success = glGetError() == GL_NO_ERROR;
+  }
+  glBindTexture(GL_TEXTURE_2D,previous);
+  return success;
+}
+bool CDVPrivateScanout::Begin(uint64_t frame, int64_t pts)
+{ return m_initialized && m_acquire(&m_slots,{frame,pts},&m_lease) == 0; }
+bool CDVPrivateScanout::Written(dv_scanout_outcome outcome)
+{ return m_initialized && m_written(&m_slots,&m_lease,outcome) == 0; }
+bool CDVPrivateScanout::Presented(bool success)
+{ return m_initialized && m_committed(&m_slots,&m_lease,success ? DV_SCANOUT_ACCEPTED : DV_SCANOUT_REJECTED) == 0; }
+bool CDVPrivateScanout::ResetStream()
+{ return !m_initialized || m_reset(&m_slots) == 0; }
+bool CDVPrivateScanout::Replaced()
+{
+  if (!m_initialized) return true;
+  if (m_slots.writing || m_slots.quarantined) return false;
+  m_restored(&m_slots);
+  return true;
+}
+bool CDVPrivateScanout::CanClose() const
+{ return !m_initialized || m_canDestroy(&m_slots); }
+bool CDVPrivateScanout::Close()
+{
+  if (!CanClose()) return false;
+  glDeleteTextures(2,m_texture);
+  for (unsigned slot=0;slot<2;++slot)
+  {
+    if (m_image[slot] != EGL_NO_IMAGE_KHR) m_destroyImage(m_display,m_image[slot]);
+    if (m_bo[slot]) gbm_bo_destroy(m_bo[slot]);
+    m_image[slot]=EGL_NO_IMAGE_KHR;m_bo[slot]=nullptr;m_texture[slot]=0;
+  }
+  m_initialized=false;
+  return true;
+}
+bool CDVPrivateScanout::Read(unsigned char* output, size_t bytes)
+{
+  if (!m_slots.ready || !output || bytes != 3840u*2160u*4u) return false;
+  uint32_t pitch=0;void* cookie=nullptr;
+  auto* data=static_cast<unsigned char*>(gbm_bo_map(m_bo[m_lease.slot],0,0,3840,2160,GBM_BO_TRANSFER_READ,&pitch,&cookie));
+  if (!data) return false;
+  const bool valid=pitch>=3840*4;
+  if (valid) for (size_t row=0;row<2160;++row)
+    std::memcpy(output+row*3840*4,data+row*pitch,3840*4);
+  gbm_bo_unmap(m_bo[m_lease.slot],cookie);
+  return valid;
+}
