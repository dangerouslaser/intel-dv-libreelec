+private:
+  dv_scanout_slots m_slots{};
+  dv_scanout_lease m_lease{};
+  bool m_initialized{false};
+  gbm_bo* m_bo[2]{};
+  unsigned m_texture[2]{};
+  EGLImageKHR m_image[2]{EGL_NO_IMAGE_KHR,EGL_NO_IMAGE_KHR};
+  EGLDisplay m_display{EGL_NO_DISPLAY};
+  PFNEGLDESTROYIMAGEKHRPROC m_destroyImage{nullptr};
+  decltype(&dv_scanout_slots_init) m_init{nullptr};
+  decltype(&dv_scanout_slots_acquire) m_acquire{nullptr};
+  decltype(&dv_scanout_slots_written) m_written{nullptr};
+  decltype(&dv_scanout_slots_committed) m_committed{nullptr};
+  decltype(&dv_scanout_slots_reset_stream) m_reset{nullptr};
+  decltype(&dv_scanout_slots_restored) m_restored{nullptr};
+  decltype(&dv_scanout_slots_can_destroy) m_canDestroy{nullptr};
+};
