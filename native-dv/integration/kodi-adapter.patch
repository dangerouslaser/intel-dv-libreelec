+  m_sourceFrame = false;
+  m_prepared = m_packed = false;
+  const char* sourceBypass = allowPacked ? "source-eligibility" : "overlay-gate";
+  if (allowPacked && SourceEligible(base, enhancement, geometry))
+  {
+    if (!m_source) m_source = new CDVPrivateSource;
+    if (!m_wasSource) m_source->Reset();
+    const dv_source_geometry placement{static_cast<unsigned>(base.width), static_cast<unsigned>(base.height),
+                                       3840, 2160, static_cast<unsigned>(geometry.x), static_cast<unsigned>(geometry.y),
+                                       SourcePlaneSiting(enhancement != nullptr, base.chromaPosition),
+                                       static_cast<unsigned>(geometry.width), static_cast<unsigned>(geometry.height)};
+    const dv_source_input input{sizeof(dv_source_input),
+        base.layout == DVBRIDGE_NV12 ? DV_SOURCE_INPUT_NV12 : DV_SOURCE_INPUT_P010,
+        base.layout == DVBRIDGE_NV12 ? 8u : 10u};
+    int result = m_source->Prepare(base.vaDisplay, base.vaSurface, base.vaOwner, enhancement,
+                                    metadata.Data(), metadata.Size(), static_cast<int64_t>(base.pts), placement, input,
