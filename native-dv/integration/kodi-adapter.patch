+#include <cstring>
+#include <chrono>
+extern "C"
+{
+#include <libavutil/frame.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_vaapi.h>
+}
+
+bool CDVPrivateSource::Initialize(void* display)
+{
+  const char* library = std::getenv("DV_PRIVATE_SOURCE_LIBRARY");
+  const char* resources = std::getenv("DV_PRIVATE_SOURCE_RESOURCES");
+  if (!library || !resources || eglGetCurrentContext() == EGL_NO_CONTEXT)
+    return false;
+  m_library = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+  if (!m_library)
+  {
+    CLog::Log(LOGERROR, "Private source renderer load failed: {}", dlerror());
+    return false;
+  }
+  auto abi = reinterpret_cast<unsigned (*)()>(dlsym(m_library, "dv_source_renderer_abi"));
+  m_create = reinterpret_cast<decltype(m_create)>(dlsym(m_library, "dv_source_renderer_create"));
+  m_render = reinterpret_cast<decltype(m_render)>(dlsym(m_library, "dv_source_renderer_render"));
+  m_drain = reinterpret_cast<decltype(m_drain)>(dlsym(m_library, "dv_source_renderer_drain"));
+  m_destroy = reinterpret_cast<decltype(m_destroy)>(dlsym(m_library, "dv_source_renderer_destroy"));
+  m_check = reinterpret_cast<decltype(m_check)>(dlsym(m_library, "dv_source_renderer_check"));
+  m_submit = reinterpret_cast<decltype(m_submit)>(dlsym(m_library, "dv_source_renderer_submit"));
+  m_submitInput = reinterpret_cast<decltype(m_submitInput)>(dlsym(m_library, "dv_source_renderer_submit_input"));
+  m_present = reinterpret_cast<decltype(m_present)>(dlsym(m_library, "dv_source_renderer_present"));
+  m_prepareOverlays = reinterpret_cast<decltype(m_prepareOverlays)>(dlsym(m_library, "dv_source_renderer_prepare_overlays"));
+  m_presentOverlay = reinterpret_cast<decltype(m_presentOverlay)>(dlsym(m_library, "dv_source_renderer_present_overlay"));
+  m_cancel = reinterpret_cast<decltype(m_cancel)>(dlsym(m_library, "dv_source_renderer_cancel"));
+  if (!abi || abi() != 4 || !m_create || !m_render || !m_drain || !m_destroy)
+    return false;
+  const char* direct = std::getenv("DV_PRIVATE_SCANOUT");
+  if (direct && std::strcmp(direct,"1") == 0)
+  {
+    if (InitializeScanout(display, resources))
+    {
+      m_display = display;
+      CLog::Log(LOGINFO,"Private source direct scanout initialized: two cached buffers, one engine");
+      return InitializeOverlays();
+    }
+    // No frame has been submitted; destroy CL imports before their GL/GBM storage.
+    glFinish();
+    if (m_engine && m_destroy(m_engine) != 0) return false;
+    m_engine = nullptr;
+    if (m_scanout)
+    {
+      if (!m_scanout->Close()) return false;
+      delete m_scanout;
+      m_scanout = nullptr;
+    }
+    m_texture = 0;
+    CLog::Log(LOGWARNING,"Private source direct scanout setup unavailable; using native copy output");
+  }
+  GLint texture;
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+  glGenTextures(1, &m_texture);
+  glBindTexture(GL_TEXTURE_2D, m_texture);
+  glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, 3840, 2160);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glBindTexture(GL_TEXTURE_2D, texture);
+  glFinish();
+  m_engine = m_create(reinterpret_cast<uintptr_t>(display),
+                      reinterpret_cast<uintptr_t>(eglGetCurrentDisplay()),
+                      reinterpret_cast<uintptr_t>(eglGetCurrentContext()), m_texture, resources);
+  if (!m_engine)
+    return false;
+  m_display = display;
+  glGenFramebuffers(1, &m_framebuffer);
+  GLint previous;
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &previous);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_framebuffer);
+  glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_texture, 0);
+  bool valid = glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, previous);
+  return valid && InitializeOverlays();
+}
+
+bool CDVPrivateSource::InitializeOverlays()
+{
+  const char* enabled = std::getenv("DV_PRIVATE_OVERLAY");
+  if (!enabled || std::strcmp(enabled, "1") != 0)
+    return true;
+  if (!m_submit || !m_present || !m_prepareOverlays || !m_presentOverlay ||
+      m_prepareOverlays(m_engine) != 0)
+  {
+    CLog::Log(LOGERROR, "Private source overlay initialization failed");
+    return false;
+  }
+  CLog::Log(LOGINFO, "Private source overlay programs prepared");
+  return true;
+}
+
+bool CDVPrivateSource::InitializeScanout(void* display, const char* resources)
+{
+  const char* failure = std::getenv("DV_PRIVATE_SCANOUT_TEST_FAIL");
+  const auto fail = [failure](const char* stage)
+  {
+    if (!failure || std::strcmp(failure, stage) != 0) return false;
+    CLog::Log(LOGWARNING,"Private source scanout injected setup failure: {}", stage);
+    return true;
+  };
+  m_createStorage = reinterpret_cast<decltype(m_createStorage)>(dlsym(m_library,"dv_source_renderer_create_storage"));
+  m_attachOutput = reinterpret_cast<decltype(m_attachOutput)>(dlsym(m_library,"dv_source_renderer_attach_output"));
+  m_selectOutput = reinterpret_cast<decltype(m_selectOutput)>(dlsym(m_library,"dv_source_renderer_select_output"));
+  auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbm*>(CServiceBroker::GetWinSystem());
+  if (!m_createStorage || !m_attachOutput || !m_selectOutput || !window) return false;
+  m_scanout = new CDVPrivateScanout;
+  if (!m_scanout->Initialize(window->GetGBMDevice().Get(),m_library)) return false;
+  m_texture = m_scanout->Texture(0);
+  if (fail("buffers")) return false;
+  m_engine = m_createStorage(reinterpret_cast<uintptr_t>(display),
+      reinterpret_cast<uintptr_t>(eglGetCurrentDisplay()),reinterpret_cast<uintptr_t>(eglGetCurrentContext()),
+      m_texture,resources,1);
+  if (!m_engine || fail("engine")) return false;
+  if (m_attachOutput(m_engine,m_scanout->Texture(1)) != 0 || fail("attached")) return false;
+  return true;
+}
+
+void CDVPrivateSource::ReleaseInputs()
+{
+  m_enhancement.reset();
+  if (m_owner)
+    m_owner->Release();
+  m_owner = nullptr;
+}
+
+int CDVPrivateSource::AcquireFrame(void* display, CVideoBuffer* owner,
+                                  const AVFrame* enhancement, int64_t pts,
+                                  const dv_source_geometry& geometry,
+                                  const void* metadata, size_t size)
+{
+  if (m_unsafe)
+    return -1;
+  if (!display || !owner)
+    return 0;
+  if (enhancement)
+  {
+    if (enhancement->format != AV_PIX_FMT_VAAPI ||
+        !DVPrivateLayerGeometryMatches(metadata, size, geometry.width, geometry.height,
+                                       enhancement->width, enhancement->height) ||
+        !enhancement->hw_frames_ctx || enhancement->pts != pts)
+      return 0;
+    auto* frames = reinterpret_cast<AVHWFramesContext*>(enhancement->hw_frames_ctx->data);
+    auto* va = reinterpret_cast<AVVAAPIDeviceContext*>(frames->device_ctx->hwctx);
+    if (frames->sw_format != AV_PIX_FMT_P010 || va->display != display)
+      return 0;
+  }
+  if (!m_engine && !Initialize(display))
+  {
+    Close();
+    return -1;
+  }
+  if (m_display != display)
+    return -1;
+  if (enhancement)
+  {
+    auto* copy = av_frame_clone(enhancement);
+    if (!copy)
+      return -1;
+    m_enhancement = {copy, [](AVFrame* frame) { av_frame_free(&frame); }};
+  }
+  owner->Acquire();
+  m_owner = owner;
+  return 1;
+}
+
+bool CDVPrivateSource::Matches(void* display, CVideoBuffer* owner, int64_t pts,
+                              const dv_source_geometry& geometry, const dv_source_input& input) const
+{
+  return !m_unsafe && m_pending && m_display == display && m_owner == owner &&
+         m_pendingPts == pts && std::memcmp(&m_pendingGeometry, &geometry, sizeof(geometry)) == 0 &&
+         std::memcmp(&m_pendingInput, &input, sizeof(input)) == 0;
+}
+
+bool CDVPrivateSource::CancelPending()
+{
+  if (m_unsafe)
+    return false;
+  if (m_pending && (!m_cancel || m_cancel(m_engine) != 0))
+  {
+    m_unsafe = true;
+    return false;
+  }
+  m_pending = false;
+  ReleaseInputs();
+  return true;
+}
+
+void CDVPrivateSource::Prefetch(void* display, unsigned surface, CVideoBuffer* owner,
+                               const AVFrame* enhancement, const void* metadata,
+                               size_t size, int64_t pts, const dv_source_geometry& geometry, const dv_source_input& input)
+{
+  const char* enabled = std::getenv("DV_PRIVATE_ASYNC");
+  if (!enabled || std::strcmp(enabled, "1") != 0 || m_unsafe || !m_engine ||
+      !m_submit || !m_present || !m_cancel || eglGetCurrentContext() == EGL_NO_CONTEXT)
+    return;
+  if (input.format == DV_SOURCE_INPUT_NV12 && !m_submitInput) return;
+  if (Matches(display, owner, pts, geometry, input)) return;
+  if (!CancelPending()) return;
+  if (AcquireFrame(display, owner, enhancement, pts, geometry, metadata, size) != 1) return;
+  const auto started = std::chrono::steady_clock::now();
+  const unsigned el = enhancement ? static_cast<unsigned>(reinterpret_cast<uintptr_t>(enhancement->data[3])) : UINT32_MAX;
+  m_pendingId = ++m_serial;
+  // Reconstruction does not acquire/write the packed GL image Kodi still needs.
+  const int result = input.format == DV_SOURCE_INPUT_NV12 ?
+      m_submitInput(m_engine, surface, el, geometry.width, geometry.height,
+                    metadata, size, m_pendingId, pts, &geometry, &input) :
+      m_submit(m_engine, surface, el, geometry.width, geometry.height,
+                              metadata, size, m_pendingId, pts, &geometry);
+  if (m_serial <= 12)
+    CLog::Log(LOGINFO, "Private source prefetch: id={} pts={} surface={} status={}", m_pendingId, pts, surface, result);
+  if (result != 0)
+  {
+    if (m_drain(m_engine) != 0) m_unsafe = true;
+    else ReleaseInputs();
+    return;
+  }
+  m_pending = true;
+  m_pendingPts = pts;
+  m_pendingGeometry = geometry;
+  m_pendingInput = input;
+  m_submitMs = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count();
+}
+
+int CDVPrivateSource::Prepare(void* display, unsigned surface, CVideoBuffer* owner,
+                              const AVFrame* enhancement, const void* metadata,
+                              size_t size, int64_t pts, const dv_source_geometry& geometry, const dv_source_input& input,
+                              const DVPrivateOverlay* overlay)
+{
+  m_ready = false;
+  if (m_unsafe) return -1;
+  const char* timing = m_transitionFrames ? std::getenv("DV_PRIVATE_TRANSITION_TIMING") : nullptr;
+  const char* frameTiming = m_processed < 480 ? std::getenv("DV_PRIVATE_FRAME_TIMING") : nullptr;
+  const bool trace = (timing && std::strcmp(timing, "1") == 0) ||
+                    (frameTiming && std::strcmp(frameTiming, "1") == 0);
+  const auto entered = trace ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+  const bool prefetched = Matches(display, owner, pts, geometry, input);
+  if (!prefetched)
+  {
+    if (trace && m_pending)
+      CLog::Log(LOGINFO, "Private source prefetch miss: pending_pts={} selected_pts={}",
+                m_pendingPts, pts);
+    if (!CancelPending()) return -1;
+    const int acquired = AcquireFrame(display, owner, enhancement, pts, geometry, metadata, size);
+    if (acquired != 1) return acquired;
+  }
+  if (input.format == DV_SOURCE_INPUT_NV12 && (!m_submitInput || !m_present))
+  {
+    ReleaseInputs();
+    return 0;
+  }
+  if (overlay && (!overlay->texture || !m_submit || !m_presentOverlay))
+  {
+    if (!CancelPending()) return -1;
+    ReleaseInputs();
+    return -1;
+  }
+  const auto started = std::chrono::steady_clock::now();
+  const char* directNoFinish = m_scanout ? std::getenv("DV_PRIVATE_DIRECT_NO_GL_FINISH") : nullptr;
+  // Private scanout textures have no GL readers after initialization. CL
+  // release and the scanout slot contract still gate every buffer reuse.
+  if (overlay || !directNoFinish || std::strcmp(directNoFinish, "1") != 0)
+    glFinish();
+  const auto glDone = trace ? std::chrono::steady_clock::now() : started;
+  if (m_scanout)
+  {
+    if (!m_scanout->Begin(prefetched ? m_pendingId : m_serial+1,pts)) return -1;
+    if (m_selectOutput(m_engine,m_scanout->Slot()) != 0)
+    {
+      m_scanout->Written(DV_SCANOUT_REJECTED);
+      return -1;
+    }
+  }
+  const unsigned packet = m_scanout ? m_scanout->Packet() : m_packetId;
+  const bool refresh = m_scanout ? m_scanout->Refresh() : m_refresh;
+  const unsigned elSurface = enhancement ? static_cast<unsigned>(reinterpret_cast<uintptr_t>(enhancement->data[3])) : UINT32_MAX;
+  const auto present = [&](uint64_t id)
+  {
+    return overlay ? m_presentOverlay(m_engine, id, pts, packet, refresh, overlay->texture,
+                                      overlay->flipY, overlay->rgbToLms, overlay->whiteNits)
+                   : m_present(m_engine, id, pts, packet, refresh);
+  };
+  int result;
+  if (prefetched)
+    result = present(m_pendingId);
+  else if (input.format == DV_SOURCE_INPUT_NV12 || overlay)
+  {
+    const uint64_t id = ++m_serial;
+    result = input.format == DV_SOURCE_INPUT_NV12 ?
+        m_submitInput(m_engine, surface, elSurface, geometry.width, geometry.height,
+                      metadata, size, id, pts, &geometry, &input) :
+        m_submit(m_engine, surface, elSurface, geometry.width, geometry.height,
+                 metadata, size, id, pts, &geometry);
+    if (result == 0) result = present(id);
+  }
+  else
+    result = m_render(m_engine, surface, elSurface, geometry.width, geometry.height,
+                      metadata, size, ++m_serial, pts, packet, refresh, &geometry);
+  const auto renderDone = trace ? std::chrono::steady_clock::now() : started;
+  if (m_serial <= 12)
+    CLog::Log(LOGINFO, "Private source consume: pts={} prefetch={} status={}", pts, prefetched, result);
+  if (m_drain(m_engine) != 0)
+  {
+    if (m_scanout) m_scanout->Written(DV_SCANOUT_UNCERTAIN);
+    m_unsafe = true;
+    CLog::Log(LOGFATAL, "Private source renderer ownership could not drain; retaining frame leases; restart Kodi");
+    return -1;
+  }
+  const auto drained = trace ? std::chrono::steady_clock::now() : started;
+  m_pending = false;
+  ReleaseInputs();
+  if (m_scanout && !m_scanout->Written(result == 0 ? DV_SCANOUT_ACCEPTED : DV_SCANOUT_REJECTED))
+  {
+    m_unsafe = true;
+    return -1;
+  }
+  if (result == -2 && !overlay)
+    return 0;
+  if (result != 0)
+  {
+    CLog::Log(LOGERROR, "Private source renderer rejected frame pts={} status={}", pts, result);
+    return -1;
+  }
+  const double elapsed = std::chrono::duration<double, std::milli>(
+      std::chrono::steady_clock::now() - started).count();
+  const double processing = elapsed + (prefetched ? m_submitMs : 0.0);
+  m_processingMs += processing;
+  m_prefetchHits += prefetched;
+  ++m_processed;
+  m_preparedPts = pts;
+  m_drainTicket = CDVPrivateDrain::Enabled() ? CDVPrivateDrain::Get().Ticket(owner, pts) : 0;
+  m_ready = true;
+  if (trace)
+  {
+    const auto ms = [](auto end, auto begin) { return std::chrono::duration<double, std::milli>(end - begin).count(); };
+    CLog::Log(LOGINFO, "Private source transition: pts={} direct={} prefetch={} overlay={} setup_ms={} prior_gl_ms={} render_call_ms={} drain_ms={} processing_ms={} remaining={} entered_ns={}",
+        pts, m_scanout != nullptr, prefetched, overlay != nullptr, ms(started,entered), ms(glDone,started),
+        ms(renderDone,glDone), ms(drained,renderDone), processing, m_transitionFrames,
+        std::chrono::duration_cast<std::chrono::nanoseconds>(entered.time_since_epoch()).count());
+  }
+  if (m_transitionFrames) --m_transitionFrames;
+  const char* verify = std::getenv("DV_PRIVATE_VERIFY");
+  // The movie-only oracle cannot validate pixels intentionally covered by GUI.
+  if (!overlay && verify && std::strcmp(verify, "1") == 0 &&
+      (m_verifiedFrames < 6 || m_resetChecks))
+  {
+    std::vector<unsigned char> rgba(3840u * 2160u * 4u);
+    bool readValid = true;
+    if (m_scanout) readValid = m_scanout->Read(rgba.data(),rgba.size());
+    else
+    {
+    GLint previous, packBuffer, alignment, rowLength, skipRows, skipPixels;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &previous);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &packBuffer);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+    glGetIntegerv(GL_PACK_ROW_LENGTH, &rowLength);
+    glGetIntegerv(GL_PACK_SKIP_ROWS, &skipRows);
+    glGetIntegerv(GL_PACK_SKIP_PIXELS, &skipPixels);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    glPixelStorei(GL_PACK_SKIP_ROWS, 0);
+    glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, m_framebuffer);
+    glReadPixels(0, 0, 3840, 2160, GL_RGBA, GL_UNSIGNED_BYTE, rgba.data());
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, previous);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, packBuffer);
+    glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+    glPixelStorei(GL_PACK_ROW_LENGTH, rowLength);
+    glPixelStorei(GL_PACK_SKIP_ROWS, skipRows);
+    glPixelStorei(GL_PACK_SKIP_PIXELS, skipPixels);
+    }
+    if (!readValid || glGetError() != GL_NO_ERROR || !m_check || m_check(m_engine, rgba.data(), rgba.size()) != 0)
+    {
+      m_ready = false;
+      CLog::Log(LOGERROR, "Private source GL output verification failed at pts={}", pts);
+      return -1;
+    }
+    const bool resized = geometry.destination_width &&
+        (geometry.destination_width != geometry.width || geometry.destination_height != geometry.height);
+    CLog::Log(LOGINFO, "Private source GL output verified: pts={} bytes={} check={} prefetch={} after_reset={}",
+        pts, rgba.size(), resized ? "sample-tolerance-and-payload" : "byte-exact", prefetched, m_resetChecks != 0);
+    if (m_resetChecks) --m_resetChecks;
+    if (m_verifiedFrames < 6) ++m_verifiedFrames;
+  }
+  if (m_processed == 1 || m_processed % 120 == 0)
+    CLog::Log(LOGINFO, "Private source frame: serial={} pts={} prepared=true processing_ms={} mean_ms={} diagnostic_readback={} colour_conversion=false prefetch_hit={} prefetch_hits={} present_wait_ms={} submit_ms={}", m_serial, pts, processing, m_processingMs / m_processed, verify && std::strcmp(verify, "1") == 0, prefetched, m_prefetchHits, elapsed, prefetched ? m_submitMs : 0.0);
+  return 1;
+}
+
+bool CDVPrivateSource::Pack(unsigned framebuffer, int width, int height, bool flipY)
+{
+  if (m_scanout) return false;
+  if (!m_ready || width != 3840 || height != 2160 || !flipY)
+    return false;
+  GLint read, draw;
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+  const bool scissor = glIsEnabled(GL_SCISSOR_TEST), dither = glIsEnabled(GL_DITHER);
+  glDisable(GL_SCISSOR_TEST);
+  glDisable(GL_DITHER);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, m_framebuffer);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, framebuffer);
+  glBlitFramebuffer(0, 0, width, height, 0, height, width, 0, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+  const bool valid = glGetError() == GL_NO_ERROR;
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, read);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw);
+  if (scissor) glEnable(GL_SCISSOR_TEST);
+  if (dither) glEnable(GL_DITHER);
+  return valid;
+}
+
+void CDVPrivateSource::Presented(bool success)
+{
+  const char* endpointTrace = std::getenv("DV_PRIVATE_ENDPOINT_TRACE");
+  if (m_ready && endpointTrace && std::strcmp(endpointTrace, "1") == 0)
+    CLog::Log(LOGINFO, "Private endpoint display commit: pts={} success={} direct={}",
+              m_preparedPts, success, m_scanout != nullptr);
+  if (m_scanout && m_ready && !m_scanout->Presented(success)) m_unsafe = true;
+  if (m_ready && success)
+  {
+    if (!m_unsafe)
+      CDVPrivateDrain::Get().Commit(m_drainTicket);
+    m_packetId = (m_packetId + 1) & 15;
+    m_refresh = false;
+    ++m_presented;
+  }
+  else m_refresh = true;
+  m_ready = false;
+}
+void CDVPrivateSource::Reset()
+{
+  if (!CancelPending()) m_unsafe = true;
+  if (m_scanout && !m_scanout->ResetStream()) m_unsafe = true;
+  m_ready = false;
+  m_refresh = true;
+  m_packetId = 0;
+  m_transitionFrames = 3;
+  const char* verifyReset = std::getenv("DV_PRIVATE_VERIFY_RESET");
+  m_resetChecks = m_processed && verifyReset && std::strcmp(verifyReset, "1") == 0 ? 3 : 0;
+}
+bool CDVPrivateSource::Close()
+{
+  if (m_scanout && !m_scanout->CanClose()) return false;
+  glFinish();
+  if (m_engine && m_destroy(m_engine) != 0)
+    return false;
+  m_engine = nullptr;
+  ReleaseInputs();
+  glDeleteFramebuffers(1, &m_framebuffer);
+  if (m_scanout)
+  {
+    if (!m_scanout->Close()) return false;
+    delete m_scanout;
+    m_scanout = nullptr;
+  }
+  else glDeleteTextures(1, &m_texture);
+  m_framebuffer = m_texture = 0;
+  if (m_library) dlclose(m_library);
+  m_library = nullptr;
+  CLog::Log(LOGINFO, "Private source renderer closed: processed={} submissions={} presented={}", m_processed, m_serial, m_presented);
+  return true;
+}
+
+gbm_bo* CDVPrivateSource::ScanoutBuffer() const
+{ return m_ready && m_scanout ? m_scanout->ReadyBuffer() : nullptr; }
+bool CDVPrivateSource::DisplayReplaced()
+{
+  if (!m_scanout) return true;
+  if (!CancelPending() || !m_scanout->Replaced()) return false;
+  m_ready = false;
+  return true;
+}
