diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateDrain.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateDrain.h
new file mode 100644
index 00000000..219ed539
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateDrain.h
@@ -0,0 +1,80 @@
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+class CDVPrivateDrain
+{
+public:
+  enum class Result { Idle, Complete, Cancelled, TimedOut };
+  static bool Enabled()
+  {
+    const char* value = std::getenv("DV_PRIVATE_DRAIN_EOF");
+    return value && std::strcmp(value, "1") == 0;
+  }
+  static CDVPrivateDrain& Get()
+  {
+    static CDVPrivateDrain state;
+    return state;
+  }
+  void Queue(const void* owner, int64_t pts)
+  {
+    std::lock_guard lock(m_mutex);
+    ++m_serial;
+    m_owner = owner;
+    m_pts = pts;
+    m_changed.notify_all();
+  }
+  uint64_t Ticket(const void* owner, int64_t pts)
+  {
+    std::lock_guard lock(m_mutex);
+    return owner && owner == m_owner && pts == m_pts ? m_serial : 0;
+  }
+  void Commit(uint64_t ticket)
+  {
+    std::lock_guard lock(m_mutex);
+    if (ticket && ticket == m_serial && m_owner)
+    {
+      m_committed = ticket;
+      m_changed.notify_all();
+    }
+  }
+  void Cancel()
+  {
+    std::lock_guard lock(m_mutex);
+    ++m_serial;
+    m_owner = nullptr;
+    m_changed.notify_all();
+  }
+  Result Wait(const volatile std::atomic_bool& abort, std::chrono::milliseconds timeout)
+  {
+    std::unique_lock lock(m_mutex);
+    if (!m_owner)
+      return Result::Idle;
+    const auto serial = m_serial;
+    const auto deadline = std::chrono::steady_clock::now() + timeout;
+    for (;;)
+    {
+      if (abort || serial != m_serial)
+        return Result::Cancelled;
+      if (m_committed == serial)
+        return Result::Complete;
+      const auto now = std::chrono::steady_clock::now();
+      if (now >= deadline)
+        return Result::TimedOut;
+      m_changed.wait_until(lock, std::min(deadline, now + std::chrono::milliseconds(20)));
+    }
+  }
+private:
+  std::mutex m_mutex;
+  std::condition_variable m_changed;
+  uint64_t m_serial{0}, m_committed{0};
+  const void* m_owner{nullptr}; // Identity only; frame leases remain with Kodi.
+  int64_t m_pts{0};
+};
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateLayerGeometry.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateLayerGeometry.h
new file mode 100644
index 00000000..d286f872
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateLayerGeometry.h
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <cstddef>
+#include <cstring>
+extern "C"
+{
+#include <libavutil/dovi_meta.h>
+}
+
+inline bool DVPrivateLayerGeometryMatches(const void* data, size_t size,
+                                         unsigned width, unsigned height,
+                                         int enhancementWidth, int enhancementHeight)
+{
+  if (!data || size < sizeof(AVDOVIMetadata) || !width || !height)
+    return false;
+  AVDOVIMetadata metadata;
+  std::memcpy(&metadata, data, sizeof(metadata));
+  if (metadata.header_offset < sizeof(metadata) || metadata.header_offset > size ||
+      sizeof(AVDOVIRpuDataHeader) > size - metadata.header_offset)
+    return false;
+  AVDOVIRpuDataHeader header;
+  std::memcpy(&header, static_cast<const unsigned char*>(data) + metadata.header_offset,
+              sizeof(header));
+  if (header.el_spatial_resampling_filter_flag > 1 ||
+      enhancementWidth <= 0 || enhancementHeight <= 0)
+    return false;
+  const unsigned scale = header.el_spatial_resampling_filter_flag ? 2 : 1;
+  return width % scale == 0 && height % scale == 0 &&
+         static_cast<unsigned>(enhancementWidth) == width / scale &&
+         static_cast<unsigned>(enhancementHeight) == height / scale;
+}
