+bool CDVBridgeGLES::SourceEligible(const Layer& base, const AVFrame* enhancement,
+                                 dvbridge_geometry geometry) const
+{
+  const char* enabled = std::getenv("DV_PRIVATE_SOURCE");
+  const char* resize = std::getenv("DV_PRIVATE_RESIZE");
+  const bool allowResize = resize && std::strcmp(resize, "1") == 0;
+  const char* nv12 = std::getenv("DV_SINGLE_NV12");
+  const char* piecewise = std::getenv("DV_SINGLE_PIECEWISE");
+  const bool allowNV12 = nv12 && std::strcmp(nv12,"1") == 0 && piecewise &&
+      std::strcmp(piecewise,"1") == 0 && !enhancement && SourceSitingEnabled() &&
+      base.chromaPosition == AVCHROMA_LOC_LEFT;
+  const bool eligible = enabled && std::strcmp(enabled, "1") == 0 && !m_hdr10 &&
+      base.width > 0 && base.width <= 3840 && base.height > 0 && base.height <= 2160 &&
+      base.width % 4 == 0 && base.height % 4 == 0 &&
+      (base.layout == DVBRIDGE_P010 || (allowNV12 && base.layout == DVBRIDGE_NV12)) &&
+      geometry.x >= 0 && geometry.y >= 0 && geometry.x % 2 == 0 && geometry.y % 2 == 0 &&
+      geometry.width > 0 && geometry.width <= 3840 && geometry.height > 0 && geometry.height <= 2160 &&
+      geometry.width % 4 == 0 && geometry.height % 4 == 0 &&
+      geometry.x <= 3840 - geometry.width && geometry.y <= 2160 - geometry.height &&
+      (allowResize || (geometry.width == base.width && geometry.height == base.height)) &&
+      (enhancement || base.chromaPosition == AVCHROMA_LOC_TOPLEFT ||
+       (SourceSitingEnabled() && base.chromaPosition == AVCHROMA_LOC_LEFT)) &&
+      base.vaOwner && base.vaDisplay && std::isfinite(base.pts) &&
+      base.pts >= -9223372036854775808.0 && base.pts < 9223372036854775808.0;
+  if (!eligible && SourceSitingEnabled())
+  {
+    static unsigned reported = 0;
+    if (reported++ < 8)
+      CLog::Log(LOGINFO, "Private source selection rejected: size={}x{} layout={} chroma={} placement={},{},{}x{} owner={} display={} enhancement={} hdr10={}",
+          base.width, base.height, base.layout, base.chromaPosition, geometry.x, geometry.y,
+          geometry.width, geometry.height, base.vaOwner != nullptr, base.vaDisplay != nullptr,
+          enhancement != nullptr, m_hdr10);
+  }
+  return eligible;
+}
+
+void CDVBridgeGLES::PrefetchHardware(const Layer& base, const AVFrame* enhancement,
+                                    const CDVMetadataBuffer& metadata, dvbridge_geometry geometry)
+{
+  if (!m_source || !m_wasSource || !SourceEligible(base, enhancement, geometry))
+    return;
+  const dv_source_geometry placement{static_cast<unsigned>(base.width), static_cast<unsigned>(base.height),
+                                     3840, 2160, static_cast<unsigned>(geometry.x), static_cast<unsigned>(geometry.y),
+                                     SourcePlaneSiting(enhancement != nullptr, base.chromaPosition),
+                                     static_cast<unsigned>(geometry.width), static_cast<unsigned>(geometry.height)};
+  const dv_source_input input{sizeof(dv_source_input),
+      base.layout == DVBRIDGE_NV12 ? DV_SOURCE_INPUT_NV12 : DV_SOURCE_INPUT_P010,
+      base.layout == DVBRIDGE_NV12 ? 8u : 10u};
+  m_source->Prefetch(base.vaDisplay, base.vaSurface, base.vaOwner, enhancement,
+                     metadata.Data(), metadata.Size(), static_cast<int64_t>(base.pts), placement, input);
+}
+
