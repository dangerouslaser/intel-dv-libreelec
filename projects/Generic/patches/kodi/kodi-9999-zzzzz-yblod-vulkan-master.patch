+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <cstddef>
+#include <cstdint>
+#include <dv-engine-vk/dv_engine_vk.h>
+
+struct gbm_device;
+struct gbm_bo;
+
+/* YBLOD's Dolby Vision engine on Vulkan compute (libdv_engine_vk.so.0) as a
+ * Master Reference engine. It reconstructs and packs the unscaled picture on
+ * the decoded VA surfaces into one of two linear buffers of its own; the
+ * finished carrier is then copied 1:1 into CB1's output framebuffer, so the
+ * presentation, metadata admission and HDMI handshake stay CB1's.
+ * All methods require Kodi's GL context. */
+class CDVYblodVulkan
+{
+public:
+  ~CDVYblodVulkan();
+  /* true: the carrier is in `framebuffer` (GPU complete). false: this picture
+   * is not the engine's (or it failed); nothing was written there. */
+  bool Render(void* vaDisplay, unsigned blSurface, unsigned elSurface, int width, int height,
+              int x, int y, bool topLeft, const void* metadata, size_t size, int64_t pts,
+              unsigned framebuffer, int targetWidth, int targetHeight, bool flipY);
+  /* The rendered picture was (not) presented: the metadata packet state follows it. */
+  void Presented(bool success);
+  void Reset();
+
+private:
+  bool Initialize(void* vaDisplay);
+  void Close();
+  void* m_library{nullptr};
+  dvvk_engine* m_engine{nullptr};
+  decltype(&dvvk_create) m_create{nullptr};
+  decltype(&dvvk_set_output) m_setOutput{nullptr};
+  decltype(&dvvk_render_sync) m_renderSync{nullptr};
+  decltype(&dvvk_reset) m_reset{nullptr};
+  decltype(&dvvk_destroy) m_destroy{nullptr};
+  void* m_vaDisplay{nullptr};
+  gbm_device* m_device{nullptr};
+  EGLDisplay m_display{EGL_NO_DISPLAY};
+  PFNEGLDESTROYIMAGEKHRPROC m_destroyImage{nullptr};
+  struct Slot
+  {
+    gbm_bo* bo{nullptr};
+    EGLImageKHR image{EGL_NO_IMAGE_KHR};
+    unsigned texture{0}, framebuffer{0};
+  } m_slots[2];
+  unsigned m_slot{0}, m_packetId{0}, m_reports{0};
+  bool m_refresh{true}, m_rendered{false}, m_failed{false};
+};
