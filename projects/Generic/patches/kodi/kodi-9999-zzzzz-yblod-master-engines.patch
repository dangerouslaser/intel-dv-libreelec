+
+void CDVBridgeGLES::BeginCB1Timer()
+{
+  m_cb1Timing = false;
+  static const auto gen = reinterpret_cast<PFNGLGENQUERIESEXTPROC>(eglGetProcAddress("glGenQueriesEXT"));
+  static const auto begin = reinterpret_cast<PFNGLBEGINQUERYEXTPROC>(eglGetProcAddress("glBeginQueryEXT"));
+  static const auto available = reinterpret_cast<PFNGLGETQUERYOBJECTUIVEXTPROC>(eglGetProcAddress("glGetQueryObjectuivEXT"));
+  static const auto result = reinterpret_cast<PFNGLGETQUERYOBJECTUI64VEXTPROC>(eglGetProcAddress("glGetQueryObjectui64vEXT"));
+  if (!m_cb1QueryUsable || !gen || !begin || !available || !result)
+  {
+    m_cb1QueryUsable = false;
+    return;
+  }
+  if (!m_cb1Queries[0])
+    gen(4, m_cb1Queries);
+  // Finished queries into the smoothed time, never waiting for one.
+  for (unsigned i = 0; i < 4; ++i)
+  {
+    GLuint ready = 0;
+    if (!m_cb1QueryPending[i])
+      continue;
+    available(m_cb1Queries[i], GL_QUERY_RESULT_AVAILABLE_EXT, &ready);
+    if (!ready)
+      continue;
+    GLuint64 ns = 0;
+    result(m_cb1Queries[i], GL_QUERY_RESULT_EXT, &ns);
+    m_cb1QueryPending[i] = false;
+    const double ms = ns / 1e6;
+    m_cb1FrameMs = m_cb1FrameMs < 0 ? ms : m_cb1FrameMs + (ms - m_cb1FrameMs) / 32.0;
+  }
+  const unsigned slot = m_cb1QueryHead % 4;
+  if (m_cb1QueryPending[slot])
+    return;   // still running: skip timing this picture
+  begin(GL_TIME_ELAPSED_EXT, m_cb1Queries[slot]);
+  m_cb1Timing = true;
+}
+
+void CDVBridgeGLES::EndCB1Timer()
+{
+  static const auto end = reinterpret_cast<PFNGLENDQUERYEXTPROC>(eglGetProcAddress("glEndQueryEXT"));
+  if (!m_cb1Timing || !end)
+    return;
+  end(GL_TIME_ELAPSED_EXT);
+  m_cb1QueryPending[m_cb1QueryHead++ % 4] = true;
+  m_cb1Timing = false;
+}
