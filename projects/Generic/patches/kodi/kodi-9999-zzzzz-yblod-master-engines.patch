+bool CDVBridgeGLES::PrepareYblod(const Layer& base, const Layer* enhancement,
+                                 const CDVMetadataBuffer& metadata, const dvbridge_geometry& geometry)
+{
+  // Unscaled pictures without menus or subtitles; everything else is CB1's.
+  // Kodi gives the whole source as the crop and the integer destination as the
+  // placement (all zero keeps both too); the engines place at even x, y.
+  const float crop[4]{0, 0, float(base.width), float(base.height)};
+  const float placed[4]{float(geometry.x), float(geometry.y), float(geometry.x + geometry.width),
+                        float(geometry.y + geometry.height)};
+  const auto zero = [](const float* v) { return !v[0] && !v[1] && !v[2] && !v[3]; };
+  const bool unscaled = geometry.width == base.width && geometry.height == base.height &&
+      geometry.source_width == base.width && geometry.source_height == base.height &&
+      !(geometry.x & 1) && !(geometry.y & 1) &&
+      (zero(geometry.crop) || std::equal(std::begin(crop), std::end(crop), std::begin(geometry.crop))) &&
+      (zero(geometry.placement) || std::equal(std::begin(placed), std::end(placed), std::begin(geometry.placement)));
+  // CB1 keeps its overlay shader primed with an empty rectangle: nothing is drawn.
+  const bool overlay = m_nativeOverlayEnabled && !zero(m_nativeOverlay.rect);
+  static unsigned declined = 0;
+  if (m_requested.masterEngine >= 1 && (!unscaled || overlay) && declined++ < 4)
+    CLog::Log(LOGINFO, "YBLOD engine: CB1 renders this picture (unscaled={} overlay={} {}x{} at {},{})",
+              unscaled, overlay, geometry.width, geometry.height, geometry.x, geometry.y);
+  if (m_requested.masterEngine < 1 || m_requested.masterIPT || overlay || !unscaled ||
+      !base.vaDisplay || base.vaSurface == 0xffffffff || (enhancement && enhancement->vaSurface == 0xffffffff) ||
+      m_scanoutFramebuffer != 0)
+    return false;
+  if (!m_yblod) m_yblod = std::make_unique<CDVYblodEngine>();
+  // CB1's siting (Kodi's SourceChroma).
+  const bool topLeft = SourceChroma(base.chromaLocation, base.sourceInfo.profile) == PL_CHROMA_TOP_LEFT;
+  const auto backend = m_requested.masterEngine == 2 ? CDVYblodEngine::Backend::OpenCL :
+      CDVYblodEngine::Backend::Vulkan;
+  m_yblodFrame = m_yblod->Render(backend, base.vaDisplay, base.vaSurface,
+      enhancement ? enhancement->vaSurface : 0xffffffffu, base.width, base.height, geometry.x, geometry.y,
+      topLeft, base.layout == DVBRIDGE_NV12, metadata.Data(), metadata.Size(), base.pts,
+      m_scanoutFramebuffer, geometry.target_width, geometry.target_height, true);
+  return m_yblodFrame;
 }
 
