+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <cstddef>
+#include <cstdint>
+#include <dv-engine-vk/dv_engine_vk.h>
+#include <native-dv/dv_source_renderer.h>
+
+struct gbm_device;
+struct gbm_bo;
+typedef struct __GLsync* GLsync;
+
+/* YBLOD's Dolby Vision engines as Master Reference engines: on Vulkan compute
+ * (libdv_engine_vk.so.0) or OpenCL (libdv_source_private.so.1, Intel). Both run
+ * CB1's spatial contract, so the carrier is byte for byte CB1's Master
+ * Reference. They reconstruct and pack the unscaled picture from the decoded VA
+ * surfaces into a linear buffer of their own; the finished carrier is copied
+ * 1:1 into CB1's output framebuffer, so presentation, metadata admission and
+ * the HDMI handshake stay CB1's. All methods require Kodi's GL context. */
+class CDVYblodEngine
+{
+public:
+  enum class Backend { Vulkan, OpenCL };
+  ~CDVYblodEngine();
+  /* true: the carrier is in `framebuffer`. false: this picture is not the
+   * engine's (or it failed); nothing was written there. */
+  bool Render(Backend backend, void* vaDisplay, unsigned blSurface, unsigned elSurface, int width,
+              int height, int x, int y, bool topLeft, bool nv12, const void* metadata, size_t size,
+              double pts, unsigned framebuffer, int targetWidth, int targetHeight, bool flipY);
+  /* The rendered picture was (not) presented: the metadata state follows it. */
+  void Presented(bool success);
+  void Reset();
+
+private:
+  bool Initialize(Backend backend, void* vaDisplay);
+  bool InitializeVulkan(int drmFd, void* vaDisplay);
+  bool InitializeOpenCL(void* vaDisplay);
+  bool InitializeSlots();
+  int RenderVulkan(unsigned slot, unsigned blSurface, unsigned elSurface, int width, int height,
+                   int x, int y, bool topLeft, bool nv12, const void* metadata, size_t size, double pts);
+  int RenderOpenCL(unsigned slot, unsigned blSurface, unsigned elSurface, int width, int height,
+                   int x, int y, bool topLeft, bool nv12, const void* metadata, size_t size, double pts);
+  void Close();
+  Backend m_backend{Backend::Vulkan};
+  void* m_library{nullptr};
+  // Vulkan
+  dvvk_engine* m_engine{nullptr};
+  decltype(&dvvk_create) m_create{nullptr};
+  decltype(&dvvk_set_output) m_setOutput{nullptr};
+  decltype(&dvvk_render_sync) m_renderSync{nullptr};
+  decltype(&dvvk_submit) m_submit{nullptr};
+  decltype(&dvvk_poll) m_poll{nullptr};
+  decltype(&dvvk_implicit_failed) m_implicitFailed{nullptr};
+  // Submitted without waiting: the frame's fence is on the carrier (implicit
+  // sync), so the GL copy waits on the GPU. Tickets still to report errors.
+  uint64_t m_tickets[4]{};
+  double m_ticketPts[4]{};
+  unsigned m_ticketCount{0};
+  void Collect();
+  decltype(&dvvk_reset) m_reset{nullptr};
+  decltype(&dvvk_destroy) m_destroy{nullptr};
+  // OpenCL
+  void* m_renderer{nullptr};
+  decltype(&dv_source_renderer_create_storage) m_clCreate{nullptr};
+  decltype(&dv_source_renderer_attach_output) m_clAttach{nullptr};
+  decltype(&dv_source_renderer_select_output) m_clSelect{nullptr};
+  decltype(&dv_source_renderer_set_el_scaler) m_clScaler{nullptr};
+  decltype(&dv_source_renderer_submit_input) m_clSubmit{nullptr};
+  decltype(&dv_source_renderer_present) m_clPresent{nullptr};
+  decltype(&dv_source_renderer_drain) m_clDrain{nullptr};
+  decltype(&dv_source_renderer_cancel) m_clCancel{nullptr};
+  decltype(&dv_source_renderer_destroy) m_clDestroy{nullptr};
+  uint64_t m_frameId{0};
+
+  void* m_vaDisplay{nullptr};
+  gbm_device* m_device{nullptr};
+  EGLDisplay m_display{EGL_NO_DISPLAY};
+  PFNEGLDESTROYIMAGEKHRPROC m_destroyImage{nullptr};
+  struct Slot
+  {
+    gbm_bo* bo{nullptr};
+    EGLImageKHR image{EGL_NO_IMAGE_KHR};
+    unsigned texture{0}, framebuffer{0};
+    int fd{-1};
+    uint32_t stride{0};
+    GLsync read{nullptr};   // the blit that last read this carrier
+  } m_slots[2];
+  unsigned m_slot{0}, m_packetId{0}, m_reports{0};
+  // CB1's metadata refresh (dvbridge_dv_metadata_output), over presented pictures.
+  uint64_t m_shown{0};
+  double m_lastPts{0}, m_renderedPts{0};
+  bool m_refresh{true}, m_rendered{false}, m_failed{false};
+};
