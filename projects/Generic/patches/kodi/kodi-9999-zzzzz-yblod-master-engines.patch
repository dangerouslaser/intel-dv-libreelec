diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVYblodEngine.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVYblodEngine.cpp
new file mode 100644
index 0000000..04573f5
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVYblodEngine.cpp
@@ -0,0 +1,407 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "DVYblodEngine.h"
+
+#include "ServiceBroker.h"
+#include "utils/log.h"
+#include "windowing/gbm/WinSystemGbm.h"
+#include "windowing/gbm/drm/DRMUtils.h"
+
+#include <GLES3/gl3.h>
+#include <GLES2/gl2ext.h>
+#include <cmath>
+#include <cstdlib>
+#include <dlfcn.h>
+#include <drm_fourcc.h>
+#include <gbm.h>
+#include <unistd.h>
+
+namespace
+{
+constexpr int CARRIER_WIDTH = 3840;
+constexpr int CARRIER_HEIGHT = 2160;
+
+const char* Name(CDVYblodEngine::Backend backend)
+{
+  return backend == CDVYblodEngine::Backend::Vulkan ? "Vulkan" : "OpenCL";
+}
+} // namespace
+
+CDVYblodEngine::~CDVYblodEngine()
+{
+  Close();
+}
+
+bool CDVYblodEngine::Initialize(Backend backend, void* vaDisplay)
+{
+  // A changed backend or decoder display starts over, with a fresh chance.
+  if ((m_engine || m_renderer || m_failed) && (backend != m_backend || vaDisplay != m_vaDisplay))
+  {
+    Close();
+    m_failed = false;
+  }
+  if (m_engine || m_renderer)
+    return true;
+  if (m_failed)
+    return false;
+  m_failed = true; // until everything below is ready
+  m_backend = backend;
+  m_vaDisplay = vaDisplay;
+  auto* winSystem = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbm*>(CServiceBroker::GetWinSystem());
+  const int drmFd = winSystem && winSystem->GetDrm() ? winSystem->GetDrm()->GetFileDescriptor() : -1;
+  if (drmFd < 0)
+    return false;
+  m_device = gbm_create_device(drmFd);
+  m_display = eglGetCurrentDisplay();
+  if (!m_device || m_display == EGL_NO_DISPLAY || !InitializeSlots())
+    return false;
+  if (!(backend == Backend::Vulkan ? InitializeVulkan(drmFd, vaDisplay) : InitializeOpenCL(vaDisplay)))
+    return false;
+  m_failed = glGetError() != GL_NO_ERROR;
+  if (!m_failed)
+    CLog::Log(LOGINFO, "YBLOD {} engine started for Master Reference", Name(backend));
+  return !m_failed;
+}
+
+bool CDVYblodEngine::InitializeSlots()
+{
+  auto create = reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(eglGetProcAddress("eglCreateImageKHR"));
+  m_destroyImage = reinterpret_cast<PFNEGLDESTROYIMAGEKHRPROC>(eglGetProcAddress("eglDestroyImageKHR"));
+  auto target = reinterpret_cast<PFNGLEGLIMAGETARGETTEXTURE2DOESPROC>(
+      eglGetProcAddress("glEGLImageTargetTexture2DOES"));
+  if (!create || !m_destroyImage || !target)
+    return false;
+  GLint texture, read;
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+  bool complete = true;
+  for (Slot& slot : m_slots)
+  {
+    // The carrier as the engines write it: linear ARGB8888, top row first.
+    slot.bo = gbm_bo_create(m_device, CARRIER_WIDTH, CARRIER_HEIGHT, GBM_FORMAT_ARGB8888,
+                            GBM_BO_USE_RENDERING | GBM_BO_USE_LINEAR);
+    slot.fd = slot.bo ? gbm_bo_get_fd(slot.bo) : -1;
+    if (slot.fd < 0)
+      return false;
+    slot.stride = gbm_bo_get_stride(slot.bo);
+    const EGLint attrs[] = {EGL_WIDTH, CARRIER_WIDTH, EGL_HEIGHT, CARRIER_HEIGHT,
+        EGL_LINUX_DRM_FOURCC_EXT, DRM_FORMAT_ARGB8888, EGL_DMA_BUF_PLANE0_FD_EXT, slot.fd,
+        EGL_DMA_BUF_PLANE0_OFFSET_EXT, 0, EGL_DMA_BUF_PLANE0_PITCH_EXT, static_cast<EGLint>(slot.stride),
+        EGL_NONE};
+    slot.image = create(m_display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attrs);
+    if (slot.image == EGL_NO_IMAGE_KHR)
+      return false;
+    glGenTextures(1, &slot.texture);
+    glBindTexture(GL_TEXTURE_2D, slot.texture);
+    target(GL_TEXTURE_2D, slot.image);
+    glGenFramebuffers(1, &slot.framebuffer);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, slot.framebuffer);
+    glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, slot.texture, 0);
+    complete = complete && glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+  }
+  glBindTexture(GL_TEXTURE_2D, texture);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, read);
+  // The OpenCL engine shares the textures through the GL context: they must exist on the GPU.
+  glFinish();
+  return complete;
+}
+
+bool CDVYblodEngine::InitializeVulkan(int drmFd, void* vaDisplay)
+{
+  m_library = dlopen("libdv_engine_vk.so.0", RTLD_NOW | RTLD_LOCAL);
+  if (!m_library)
+  {
+    CLog::Log(LOGERROR, "YBLOD Vulkan engine: {}", dlerror());
+    return false;
+  }
+#define LOAD(member, symbol) \
+  member = reinterpret_cast<decltype(member)>(dlsym(m_library, #symbol)); \
+  if (!member) \
+    return false;
+  LOAD(m_create, dvvk_create);
+  LOAD(m_setOutput, dvvk_set_output);
+  LOAD(m_renderSync, dvvk_render_sync);
+  LOAD(m_submit, dvvk_submit);
+  LOAD(m_poll, dvvk_poll);
+  LOAD(m_implicitFailed, dvvk_implicit_failed);
+  LOAD(m_reset, dvvk_reset);
+  LOAD(m_destroy, dvvk_destroy);
+  // The engine logs its reasons on stderr (the journal).
+  if (m_create(drmFd, vaDisplay, &m_engine) != 0 || !m_engine)
+  {
+    m_engine = nullptr;
+    CLog::Log(LOGERROR, "YBLOD Vulkan engine did not start (no Vulkan device for the display?)");
+    return false;
+  }
+  for (unsigned index = 0; index < 2; ++index)
+  {
+    // The engine imports its own duplicate of the buffer.
+    if (m_setOutput(m_engine, index, m_slots[index].fd, m_slots[index].stride) != 0)
+      return false;
+  }
+  return true;
+}
+
+bool CDVYblodEngine::InitializeOpenCL(void* vaDisplay)
+{
+  // CB1's spatial contract; the engine reads its settings from the environment
+  // (native-dv.env, through Kodi's service drop-in) when it is created.
+  setenv("DV_CB1_CONTRACT", "1", 1);
+  m_library = dlopen("libdv_source_private.so.1", RTLD_NOW | RTLD_LOCAL);
+  if (!m_library)
+  {
+    CLog::Log(LOGERROR, "YBLOD OpenCL engine: {}", dlerror());
+    return false;
+  }
+  LOAD(m_clCreate, dv_source_renderer_create_storage);
+  LOAD(m_clAttach, dv_source_renderer_attach_output);
+  LOAD(m_clSelect, dv_source_renderer_select_output);
+  LOAD(m_clScaler, dv_source_renderer_set_el_scaler);
+  LOAD(m_clSubmit, dv_source_renderer_submit_input);
+  LOAD(m_clPresent, dv_source_renderer_present);
+  LOAD(m_clDrain, dv_source_renderer_drain);
+  LOAD(m_clCancel, dv_source_renderer_cancel);
+  LOAD(m_clDestroy, dv_source_renderer_destroy);
+#undef LOAD
+  m_renderer = m_clCreate(reinterpret_cast<uintptr_t>(vaDisplay), reinterpret_cast<uintptr_t>(m_display),
+                          reinterpret_cast<uintptr_t>(eglGetCurrentContext()), m_slots[0].texture,
+                          "/usr/share/native-dv", DV_SOURCE_OUTPUT_BGRA);
+  if (!m_renderer)
+  {
+    CLog::Log(LOGERROR, "YBLOD OpenCL engine did not start (no Intel OpenCL device sharing the GL context?)");
+    return false;
+  }
+  // Master Reference enlarges the EL with the Annex B filters only.
+  return m_clAttach(m_renderer, m_slots[1].texture) == 0 && m_clScaler(m_renderer, 1) == 0;
+}
+
+int CDVYblodEngine::RenderVulkan(unsigned slot, unsigned blSurface, unsigned elSurface, int width,
+                                 int height, int x, int y, bool topLeft, bool nv12,
+                                 const void* metadata, size_t size, double pts)
+{
+  dvvk_frame frame{};
+  frame.plan.width = static_cast<uint32_t>(width);
+  frame.plan.height = static_cast<uint32_t>(height);
+  frame.plan.x = static_cast<uint32_t>(x);
+  frame.plan.y = static_cast<uint32_t>(y);
+  frame.plan.chroma_top_left = topLeft;
+  frame.plan.has_el = elSurface != UINT32_MAX;
+  frame.plan.nv12 = nv12;
+  frame.plan.el_scaler = 1;
+  frame.plan.fel = 1;
+  frame.plan.packet_id = m_packetId;
+  frame.plan.refresh = m_refresh;
+  frame.plan.pts = static_cast<int64_t>(std::llround(pts * 1e6));
+  frame.plan.white_nits = 203.0;
+  // CB1's spatial contract: siting, 4:2:0 reshaping and the Annex B filters.
+  frame.plan.cb1_contract = 1;
+  frame.bl_surface = blSurface;
+  frame.el_surface = elSurface;
+  frame.metadata = metadata;
+  frame.metadata_size = size;
+  frame.output = slot;
+  // Without implicit fences (an older kernel) GL could read the carrier early: wait.
+  if (m_implicitFailed(m_engine))
+  {
+    uint32_t flags = 0;
+    const int result = m_renderSync(m_engine, &frame, &flags);
+    // An out-of-range sample is shown clamped by the engine; Master rejects instead.
+    return result != 0 ? result : (flags & 3u) ? -4 : 0;
+  }
+  uint64_t ticket = 0;
+  const int result = m_submit(m_engine, &frame, &ticket);
+  if (result == 0)
+  {
+    if (m_ticketCount == 4)
+      Collect();
+    if (m_ticketCount < 4)
+    {
+      m_tickets[m_ticketCount] = ticket;
+      m_ticketPts[m_ticketCount++] = pts;
+    }
+  }
+  return result;
+}
+
+void CDVYblodEngine::Collect()
+{
+  // Finished frames' error flags; a range error was already shown (clamped).
+  unsigned kept = 0;
+  for (unsigned i = 0; i < m_ticketCount; ++i)
+  {
+    int done = 0;
+    uint32_t flags = 0;
+    if (m_poll(m_engine, m_tickets[i], &done, &flags) == 0 && !done)
+    {
+      m_tickets[kept] = m_tickets[i];
+      m_ticketPts[kept++] = m_ticketPts[i];
+    }
+    else if ((flags & 3u) && m_reports < 16)
+    {
+      ++m_reports;
+      CLog::Log(LOGWARNING, "YBLOD Vulkan engine: range check failed pts={} flags={:#x} (shown clamped)",
+                m_ticketPts[i], flags);
+    }
+  }
+  if (kept == m_ticketCount && kept == 4)
+    kept = 3;   // never block: forget the oldest
+  m_ticketCount = kept;
+}
+
+int CDVYblodEngine::RenderOpenCL(unsigned slot, unsigned blSurface, unsigned elSurface, int width,
+                                 int height, int x, int y, bool topLeft, bool nv12,
+                                 const void* metadata, size_t size, double pts)
+{
+  dv_source_geometry geometry{};
+  geometry.width = static_cast<unsigned>(width);
+  geometry.height = static_cast<unsigned>(height);
+  geometry.canvas_width = CARRIER_WIDTH;
+  geometry.canvas_height = CARRIER_HEIGHT;
+  geometry.x = static_cast<unsigned>(x);
+  geometry.y = static_cast<unsigned>(y);
+  geometry.chroma_siting = topLeft ? DV_SOURCE_CHROMA_TOP_LEFT : DV_SOURCE_CHROMA_CENTER_LEFT;
+  geometry.destination_width = static_cast<unsigned>(width);
+  geometry.destination_height = static_cast<unsigned>(height);
+  const dv_source_input input{sizeof(dv_source_input),
+                              nv12 ? DV_SOURCE_INPUT_NV12 : DV_SOURCE_INPUT_P010, nv12 ? 8u : 10u};
+  const uint64_t id = ++m_frameId;
+  const int64_t ticks = static_cast<int64_t>(std::llround(pts * 1e6));
+  int result = m_clSelect(m_renderer, slot);
+  if (result == 0)
+    result = m_clSubmit(m_renderer, blSurface, elSurface, static_cast<unsigned>(width),
+                        static_cast<unsigned>(height), metadata, size, id, ticks, &geometry, &input);
+  // The packet id is the engine's own in the contract (CB1: on payload change).
+  if (result == 0)
+    result = m_clPresent(m_renderer, id, ticks, m_packetId, m_refresh);
+  if (result != 0)
+    m_clCancel(m_renderer);
+  // Complete before GL reads the carrier.
+  const int drained = m_clDrain(m_renderer);
+  return result != 0 ? result : drained;
+}
+
+bool CDVYblodEngine::Render(Backend backend, void* vaDisplay, unsigned blSurface,
+                            unsigned elSurface, int width, int height, int x, int y, bool topLeft,
+                            bool nv12, const void* metadata, size_t size, double pts,
+                            unsigned framebuffer, int targetWidth, int targetHeight, bool flipY)
+{
+  m_rendered = false;
+  if (!vaDisplay || targetWidth != CARRIER_WIDTH || targetHeight != CARRIER_HEIGHT ||
+      !Initialize(backend, vaDisplay))
+    return false;
+  const unsigned slot = m_slot ^ 1u;
+  // The engine writes this carrier only once GL has finished copying it out.
+  if (m_slots[slot].read)
+  {
+    glClientWaitSync(m_slots[slot].read, GL_SYNC_FLUSH_COMMANDS_BIT, 1000000000ull);
+    glDeleteSync(m_slots[slot].read);
+    m_slots[slot].read = nullptr;
+  }
+  // As CB1: the first picture, a step back or a gap over 0.1 s refreshes the
+  // display; a repeated picture keeps its value; otherwise the RPU's own flag.
+  if (!m_shown)
+    m_refresh = true;
+  else if (pts != m_lastPts)
+    m_refresh = pts < m_lastPts || pts - m_lastPts > 0.1;
+  const int result = backend == Backend::Vulkan ?
+      RenderVulkan(slot, blSurface, elSurface, width, height, x, y, topLeft, nv12, metadata, size, pts) :
+      RenderOpenCL(slot, blSurface, elSurface, width, height, x, y, topLeft, nv12, metadata, size, pts);
+  if (result != 0)
+  {
+    if (m_reports < 16)
+    {
+      ++m_reports;
+      CLog::Log(LOGINFO, "YBLOD {} engine {} picture pts={} ({}): {}x{}{}; CB1 renders it", Name(backend),
+                result == -2 ? "does not take this" : "failed on", pts, result, width, height,
+                elSurface != UINT32_MAX ? " + EL" : "");
+    }
+    return false;
+  }
+  GLint read, draw;
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+  const bool scissor = glIsEnabled(GL_SCISSOR_TEST), blend = glIsEnabled(GL_BLEND);
+  glDisable(GL_SCISSOR_TEST);
+  glDisable(GL_BLEND);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, m_slots[slot].framebuffer);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, framebuffer);
+  // Same size, nearest: every carrier byte unchanged. The engines' row 0 is
+  // the HDMI top row; an EGL window's GL origin is bottom-left.
+  if (flipY)
+    glBlitFramebuffer(0, 0, CARRIER_WIDTH, CARRIER_HEIGHT, 0, CARRIER_HEIGHT, CARRIER_WIDTH, 0,
+                      GL_COLOR_BUFFER_BIT, GL_NEAREST);
+  else
+    glBlitFramebuffer(0, 0, CARRIER_WIDTH, CARRIER_HEIGHT, 0, 0, CARRIER_WIDTH, CARRIER_HEIGHT,
+                      GL_COLOR_BUFFER_BIT, GL_NEAREST);
+  m_slots[slot].read = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, read);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw);
+  if (scissor)
+    glEnable(GL_SCISSOR_TEST);
+  if (blend)
+    glEnable(GL_BLEND);
+  if (glGetError() != GL_NO_ERROR)
+    return false;
+  m_slot = slot;
+  m_renderedPts = pts;
+  m_rendered = true;
+  return true;
+}
+
+void CDVYblodEngine::Presented(bool success)
+{
+  if (m_rendered && success)
+  {
+    m_packetId = (m_packetId + 1) & 15u;
+    m_lastPts = m_renderedPts;
+    ++m_shown;
+  }
+  m_rendered = false;
+}
+
+void CDVYblodEngine::Reset()
+{
+  m_ticketCount = 0;
+  if (m_engine)
+    m_reset(m_engine);
+  if (m_renderer)
+    m_clCancel(m_renderer);
+  m_shown = 0;
+  m_rendered = false;
+  m_reports = 0;
+}
+
+void CDVYblodEngine::Close()
+{
+  if (m_engine)
+    m_destroy(m_engine);
+  m_engine = nullptr;
+  if (m_renderer)
+  {
+    m_clDrain(m_renderer);
+    m_clDestroy(m_renderer);
+  }
+  m_renderer = nullptr;
+  for (Slot& slot : m_slots)
+  {
+    if (slot.read)
+      glDeleteSync(slot.read);
+    if (slot.framebuffer)
+      glDeleteFramebuffers(1, &slot.framebuffer);
+    if (slot.texture)
+      glDeleteTextures(1, &slot.texture);
+    if (slot.image != EGL_NO_IMAGE_KHR && m_destroyImage)
+      m_destroyImage(m_display, slot.image);
+    if (slot.fd >= 0)
+      close(slot.fd);
+    if (slot.bo)
+      gbm_bo_destroy(slot.bo);
+    slot = Slot{};
+  }
+  if (m_device)
+    gbm_device_destroy(m_device);
+  m_device = nullptr;
+  if (m_library)
+    dlclose(m_library);
+  m_library = nullptr;
+  m_slot = 0;
+}
