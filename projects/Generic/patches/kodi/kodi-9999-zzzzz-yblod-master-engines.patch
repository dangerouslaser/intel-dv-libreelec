+bool CWinSystemGbmGLESContext::CreateYblodFence(const CDVBridgeGLES::Submission& submission, int fence)
+{
+  // As CreateCB1GPUFence, with the engine's fence: an explicit in-fence makes the
+  // kernel ignore the buffer's implicit one, so it must be the engine's own.
+  if (fence >= 0 && submission.asyncEligible && submission.sequence && CB1AsyncAvailable())
+  {
